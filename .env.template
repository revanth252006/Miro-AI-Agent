# ─────────────────────────────────────────
# MIRO AI AGENT — Environment Configuration
# ─────────────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control!

# ═══════════════════════════════════════════
# REQUIRED (server will warn if missing)
# ═══════════════════════════════════════════

# Secret token for WebSocket authentication & data encryption
MIRO_SECRET_TOKEN=

# Google Gemini API key (primary AI brain)
GOOGLE_API_KEY=

# Google Gemini API key (secondary/pro model, optional — falls back to primary)
GOOGLE_API_KEY_PRO=

# Gmail App Password (NOT your Google account password)
# Generate at: https://myaccount.google.com/apppasswords
GMAIL_APP_PASSWORD=

# ═══════════════════════════════════════════
# GMAIL SETTINGS
# ═══════════════════════════════════════════
GMAIL_EMAIL=
GMAIL_SENDER=

# ═══════════════════════════════════════════
# LOCAL AI (Primary Brain — free, unlimited)
# ═══════════════════════════════════════════
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# ═══════════════════════════════════════════
# OPTIONAL SERVICES
# ═══════════════════════════════════════════

# OpenAI (last-resort fallback)
# OPENAI_API_KEY=

# Picovoice wake word detection
# PICOVOICE_API_KEY=

# Supabase (if using cloud features)
# SUPABASE_URL=
# SUPABASE_KEY=
